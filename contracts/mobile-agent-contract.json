    "eventTypeMaxCharacters": 96,
    "eventTypeMaxUTF8Bytes": 384,
    "payloadMaxBytes": 262144
  },
  "characterCounting": {
    "characters": "Unicode code points",
    "bytes": "UTF-8",
    "blankCodePoints": [
      "0009-000D",
      "001C-0020",
      "0085",
      "00A0",
      "1680",
      "2000-200B",
      "2028-2029",
      "202F",
      "205F",
      "3000",
      "FEFF"
    ]
  },
  "payloadSizing": {
    "algorithm": "decoded-json-structural-budget-v1",
    "scope": "decoded_payload_budget_not_transport_frame_size",
    "string": "2_plus_raw_utf8_bytes",
    "objectKey": "3_plus_raw_utf8_bytes",
    "numberBytes": 32,
    "trueBytes": 4,
    "falseBytes": 5,
    "nullBytes": 4,
    "containerBytes": 2,
    "separatorBytes": 1
  },
  "requiredEnvelopeFields": [
    "schemaVersion",
    "eventId",
    "runId",
    "sequence",
    "type",
    "payload"
  ],
  "optionalEnvelopeFields": [
    "turnId",
    "attemptId",
    "segmentId"
  ],
  "identifierSemantics": {
    "eventId": "unique_immutable_event",
    "turnId": "stable_user_business_turn",
    "runId": "stable_logical_execution_across_resume_segments",
    "attemptId": "changes_when_the_logical_run_is_retried",
    "segmentId": "changes_on_transport_reconnect_or_resume",
    "toolCallId": "payload_identifier_for_one_model_tool_invocation",
    "commandId": "payload_identifier_for_one_device_mutation_command"
  },
  "runStatusValues": [
    "idle",
    "running",
    "waiting_device",
    "waiting_approval",
    "interrupted",
    "finished",
    "permission_denied",
    "error"
  ],
  "resultKindValues": [
    "success",
    "empty",
    "text_fallback"
  ],
  "diagnosticFields": [
    "code",
    "retryable",
    "diagnosticId"
  ],
  "criticalEventSemantics": {
    "marker": "payload.critical=true",
    "unknownBehavior": "explicit_upgrade_required_or_protocol_error_before_projection"
  },
  "versionNegotiation": {
    "supportedEventSchemaVersions": [2],
    "minimumProtocolVersion": 1,
    "maximumProtocolVersion": 2147483647,
    "selection": "highest_common_version",
    "peerMinimumAboveLocalMaximum": "upgrade_required",
    "otherNoCommonVersion": "incompatible",
    "invalidOffer": "incompatible"
  },
  "publicFailureFields": [
    "code",
    "retryable",
    "diagnosticId",
    "requiredSchemaVersion"
  ],
  "publicErrorCodes": [
    "protocol.upgrade_required",
    "protocol.no_common_version",
    "protocol.invalid_version_offer",
    "protocol.unsupported_schema_version",
    "protocol.event_collision",
    "protocol.sequence_collision",
    "protocol.replay_failed",
    "protocol.mixed_run",
    "protocol.mixed_turn",
    "protocol.event_after_terminal",
    "protocol.invalid_event",
    "protocol.unsupported_critical_event",
    "protocol.unsupported_patch"
