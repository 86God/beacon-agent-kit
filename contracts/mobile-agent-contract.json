{
  "contractVersion": 1,
  "protocol": {
    "schemaVersion": 2,
    "initialCursor": -1,
    "firstSequence": 0,
    "segmentEndCompletesTurn": false
  },
  "wireLimits": {
    "identifierMaxCharacters": 128,
