{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beaconagentkit.dev/schemas/v0.2/capability-manifest.schema.json",
  "title": "Beacon Capability Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "kind",
    "title",
    "description",
    "intentExamples",
    "inputSchema",
    "outputSchema",
    "executionLocation",
    "risk",
    "requiredScopes",
    "confirmation",
    "idempotency",
    "dependencies",
    "tags"
  ],
  "properties": {
    "schemaVersion": {"type": "integer", "minimum": 1},
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "kind": {"enum": ["tool", "skill", "workflow", "knowledge", "surface"]},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "intentExamples": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "inputSchema": {"type": "object"},
    "outputSchema": {"type": "object"},
    "executionLocation": {"enum": ["server", "device", "either"]},
    "risk": {"enum": ["read_only", "reversible_draft", "consequential_write", "destructive"]},
    "requiredScopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "confirmation": {"enum": ["never", "before_commit", "always"]},
    "idempotency": {"enum": ["none", "optional", "required"]},
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+@\\S+$"
      }
    },
    "surface": {"type": ["string", "null"], "minLength": 1},
    "tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "fallback": {"enum": ["text_summary", "none"]},
    "offlineSafe": {"type": "boolean", "default": false}
  }
}
